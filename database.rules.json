{
  "rules": {
    ".read": false,
    ".write": false,

    "editors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "data": {
      ".read": "auth != null && root.child('editors').child(auth.uid).val() === true",
      ".indexOn": ["birth_certificate/type", "data/catalog"],
      "$id": {
        ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || newData.hasChildren(['birth_certificate', 'data'])"
      }
    },

    "groups": {
      ".read": "auth != null && root.child('editors').child(auth.uid).val() === true",
      "$group": {
        "members": {
          "$id": {
            ".write": "auth != null && root.child('editors').child(auth.uid).val() === true",
            ".validate": "!newData.exists() || root.child('data').child($id).exists()"
          }
        }
      }
    },

    "gis": {
      ".read": "auth != null && root.child('editors').child(auth.uid).val() === true",
      ".write": false
    }
  }
}
